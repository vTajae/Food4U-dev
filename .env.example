# Settings for `docker compose` (copy to .env; ignored). Dev-only placeholders, never production values.
POSTGRES_USER=food4u
POSTGRES_PASSWORD=dev-only-postgres-password
POSTGRES_DB=food4u
# Must equal JWT_SECRET_KEY in frontend/.dev.vars.docker.
USER_JWT_SECRET_KEY=dev-only-jwt-secret
USER_JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
